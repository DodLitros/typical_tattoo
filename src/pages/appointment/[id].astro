---
import MainLayout from "../../layouts/MainLayout.astro";
import AppointmentCalendar from "../../features/quote/components/AppointmentCalendar";

export async function getStaticPaths() {
  return [];
}
const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}
---

<MainLayout title="Agenda tu cita">
  <AppointmentCalendar quoteRequestId={id} client:load />
</MainLayout>