---
import AppointmentCalendar from "../../features/quote/components/AppointmentCalendar";
import AppointmentLayout from "../../layouts/AppointmentLayout.astro";

export async function getStaticPaths() {
  return [];
}
const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}
---

<AppointmentLayout title="Escoge tu día">
  <AppointmentCalendar quoteRequestId={id} client:load />
</AppointmentLayout>