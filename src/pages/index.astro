---
import MainLayout from "../layouts/MainLayout.astro";
import QuoteModal from "../features/quote/components/QuoteModal";
import { getClients } from "../features/quote/services/quoteService";
import Sketchbook from "../components/portfolio/Sketchbook";

const { data: clients, error } = await getClients();

---
<MainLayout title="Typical Tattoo">
  <Sketchbook client:load />
  <QuoteModal client:only="react"/>
</MainLayout>

<style>
  .portfolio-section {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #1a1a1a; /* Fondo oscuro tipo estudio */
    padding: 2rem;
  }
  QuoteModal {
    position:fixed;
    bottom: 5vh;
    right: 5vw;
  }
</style>

