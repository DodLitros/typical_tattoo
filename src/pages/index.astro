---
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/ui/Card";
import QuoteModal from "../features/quote/components/QuoteModal";
import { getClients } from "../features/quote/services/quoteService";

const { data: clients, error } = await getClients();

---
<MainLayout title="Typical Tattoo">
  <QuoteModal client:only="react"/>
  <section>
    <h2>Clientes recientes</h2>
    {error ? (
      <p>Error: {error.message}</p>
    ) : (
      clients?.map((entry) => (
        <Card title={entry.full_name}>
          <p>Teléfono: {entry.phone}</p>
        </Card>
      ))
    )}
  </section>

  <section>
  </section>
</MainLayout>

<style>
  .portfolio-section {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #1a1a1a; /* Fondo oscuro tipo estudio */
    padding: 2rem;
  }
</style>

